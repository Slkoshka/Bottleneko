<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <Import Project="$(MSBuildProjectDirectory)\..\Bottleneko.Common.props" />

  <ItemGroup>
    <PackageReference Include="Akka" Version="1.5.46" />
    <PackageReference Include="Akka.DependencyInjection" Version="1.5.46" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="$(AspNetVersion)" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="$(AspNetVersion)" />
    <PackageReference Include="Spectre.Console.Cli" Version="0.50" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.1.0" />
  </ItemGroup>

  <!-- https://github.com/dotnet/docs/issues/44886 -->
  <ItemGroup>
    <PackageReference Include="System.Linq.Async" Version="6.0.1">
      <ExcludeAssets>all</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bottleneko.Core\Bottleneko.Core.csproj" />
    <ProjectReference Include="..\Bottleneko.ServiceDefaults\Bottleneko.ServiceDefaults.csproj" />
  </ItemGroup>

</Project>
